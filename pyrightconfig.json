{
  "$schema": "https://raw.githubusercontent.com/microsoft/pyright/main/packages/vscode-pyright/schemas/pyrightconfig.schema.json",
  "include": [
    "scenarios/unified/server",
    "scenarios/split/backend/app",
    "scenarios/split/frontend/proxy.py",
    "scenarios/u2m-postgres/backend/app",
    "scenarios/u2m-postgres/backend/tests"
  ],
  "exclude": [
    "**/node_modules",
    "**/static",
    "**/__pycache__"
  ],
  "typeCheckingMode": "standard",
  "pythonVersion": "3.11",
  "executionEnvironments": [
    {
      "root": "scenarios/unified"
    },
    {
      "root": "scenarios/split/backend"
    },
    {
      "root": "scenarios/split/frontend"
    },
    {
      "root": "scenarios/u2m-postgres/backend"
    }
  ]
}
